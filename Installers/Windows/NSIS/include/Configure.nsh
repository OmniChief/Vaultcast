; =============================================================================
; Configure.nsh - runtime configuration, database and Windows services
;
; Everything here uses NSIS commands or Windows' own tools (sc/net/icacls/netsh)
; plus the bundled PHP for the application's PHP setup code. No PowerShell.
; =============================================================================

; ---- Microsoft Visual C++ runtime (needed by PHP) ----
; Skipped when an x64 14.x runtime at least as new as the bundled one is present.
; VCREDIST_1..4 come from the bundled vc_redist.x64.exe at compile time.
Function InstallVCRuntime
  SetRegView 64
  ClearErrors
  ReadRegDWORD $0 HKLM "SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" "Installed"
  ReadRegDWORD $1 HKLM "SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" "Major"
  ReadRegDWORD $2 HKLM "SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" "Minor"
  ReadRegDWORD $3 HKLM "SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" "Bld"
  ${If} $0 == 1
  ${AndIf} $1 == ${VCREDIST_1}
    ${VersionCompare} "$1.$2.$3" "${VCREDIST_1}.${VCREDIST_2}.${VCREDIST_3}" $4
    ${If} $4 != 2   ; 0 = same, 1 = installed is newer
      DetailPrint "Microsoft Visual C++ runtime $1.$2.$3 is already installed; skipping."
      Return
    ${EndIf}
  ${EndIf}

  DetailPrint "Installing the Microsoft Visual C++ runtime ${VCREDIST_1}.${VCREDIST_2}.${VCREDIST_3} (this can take a minute)..."
  SetOutPath "$PLUGINSDIR\redist"
  File "${STAGE_DIR}\redist\vc_redist.x64.exe"
  ExecWait '"$PLUGINSDIR\redist\vc_redist.x64.exe" /install /quiet /norestart' $0
  Delete "$PLUGINSDIR\redist\vc_redist.x64.exe"
  ${If} $0 == 0
    DetailPrint "Microsoft Visual C++ runtime installed."
  ${ElseIf} $0 == 1638
    DetailPrint "A newer Microsoft Visual C++ runtime is already installed."
  ${ElseIf} $0 == 3010
    DetailPrint "Microsoft Visual C++ runtime installed; Windows will finish it at the next restart."
    SetRebootFlag true   ; offer, never force
  ${Else}
    !insertmacro Fail "The Microsoft Visual C++ runtime could not be installed (code $0)."
  ${EndIf}
FunctionEnd

; ---- Ports ----
; In: $R0 port, $R1 = 1 when public (must be exactly this port), $R2 bind address.
; Out: $R0 the port to use. Non-public ports move up to the next free one.
Function ChoosePort
  ${Do}
    ${If} $R0 > 65535
      !insertmacro Fail "No free port was found. Choose different ports in Advanced setup."
    ${EndIf}
    ClearErrors
    ${WordFind} "$ReservedPorts" "|$R0|" "E+1{" $0
    ${If} ${Errors}               ; not yet used by another Vaultcast service
      !insertmacro PhpHelper 'free $R0 $R2'
      ${If} $0 == 0
        ${Break}
      ${EndIf}
    ${EndIf}
    ${If} $R1 == 1
      !insertmacro Fail "Port $R0 is already in use. Close the program using it or pick another port in Advanced setup."
    ${EndIf}
    IntOp $R0 $R0 + 1
  ${Loop}
  StrCpy $ReservedPorts "$ReservedPorts$R0|"
FunctionEnd

; ---- php.ini ----
Function WritePhpIni
  StrCpy $1 "$Runtime\${RT_PHP}\ext"
  StrCpy $2 "$Runtime\logs\php-errors.log"
  StrCpy $3 "$INSTDIR\data\sessions"
  StrCpy $4 "$INSTDIR\data\tmp"
  StrCpy $5 "$Runtime\cacert.pem"
  !insertmacro ForwardSlashes $1
  !insertmacro ForwardSlashes $2
  !insertmacro ForwardSlashes $3
  !insertmacro ForwardSlashes $4
  !insertmacro ForwardSlashes $5
  FileOpen $9 "$Runtime\php.ini" w
  FileWrite $9 '; Generated by the Vaultcast installer. Rerun setup to regenerate.$\r$\n'
  FileWrite $9 'extension_dir="$1"$\r$\n'
  FileWrite $9 'extension=pdo_mysql$\r$\nextension=mbstring$\r$\nextension=fileinfo$\r$\n'
  FileWrite $9 'extension=curl$\r$\nextension=openssl$\r$\nextension=gd$\r$\n'
  FileWrite $9 'extension=zip$\r$\nzend_extension=opcache$\r$\nopcache.enable=1$\r$\nopcache.validate_timestamps=1$\r$\nopcache.revalidate_freq=2$\r$\n'
  FileWrite $9 'cgi.fix_pathinfo=0$\r$\ndisplay_errors=Off$\r$\nlog_errors=On$\r$\n'
  FileWrite $9 'error_log="$2"$\r$\n'
  FileWrite $9 'session.save_path="$3"$\r$\n'
  FileWrite $9 'upload_tmp_dir="$4"$\r$\nsys_temp_dir="$4"$\r$\n'
  FileWrite $9 'curl.cainfo="$5"$\r$\nopenssl.cafile="$5"$\r$\n'
  FileWrite $9 'upload_max_filesize=16M$\r$\npost_max_size=16M$\r$\n'
  FileClose $9
FunctionEnd

; ---- WinSW service registration ----
; In: $SvcId $SvcName $SvcExe $SvcArgs $SvcDir, $SvcExtra (extra XML: env/depend),
;     $SvcStopArgs (optional; switches to start/stop argument tags).
Function InstallAppService
  DetailPrint "Registering $SvcName..."
  StrCpy $6 "$Runtime\services\$SvcId.exe"
  CopyFiles /SILENT "$Runtime\WinSW.exe" "$6"

  StrCpy $1 $SvcName
  StrCpy $2 $SvcExe
  StrCpy $3 $SvcArgs
  StrCpy $4 $SvcDir
  StrCpy $5 "$Runtime\logs"
  StrCpy $7 $SvcStopArgs
  !insertmacro XmlEscape $1
  !insertmacro XmlEscape $2
  !insertmacro XmlEscape $3
  !insertmacro XmlEscape $4
  !insertmacro XmlEscape $5
  !insertmacro XmlEscape $7

  ; UTF-16 with BOM so any folder name survives; WinSW reads it natively.
  FileOpen $9 "$Runtime\services\$SvcId.xml" w
  FileWriteUTF16LE /BOM $9 '<service>$\r$\n'
  FileWriteUTF16LE $9 '  <id>$SvcId</id>$\r$\n  <name>$1</name>$\r$\n'
  FileWriteUTF16LE $9 '  <description>Vaultcast native application service</description>$\r$\n'
  FileWriteUTF16LE $9 '  <executable>$2</executable>$\r$\n'
  ${If} $SvcStopArgs == ""
    FileWriteUTF16LE $9 '  <arguments>$3</arguments>$\r$\n'
  ${Else}
    FileWriteUTF16LE $9 '  <startarguments>$3</startarguments>$\r$\n  <stoparguments>$7</stoparguments>$\r$\n'
  ${EndIf}
  FileWriteUTF16LE $9 '  <workingdirectory>$4</workingdirectory>$\r$\n'
  FileWriteUTF16LE $9 '  <startmode>Automatic</startmode>$\r$\n  <onfailure action="restart" delay="5 sec"/>$\r$\n'
  FileWriteUTF16LE $9 '  <stoptimeout>30 sec</stoptimeout>$\r$\n  <logpath>$5</logpath>$\r$\n  <log mode="roll"/>$\r$\n'
  StrCpy $0 $SvcId 12
  ${If} $0 == "VaultcastPHP"
    ; PHP runs as LocalSystem so administrator tools in the app can work.
    FileWriteUTF16LE $9 '  <serviceaccount><user>LocalSystem</user></serviceaccount>$\r$\n'
  ${Else}
    FileWriteUTF16LE $9 '  <serviceaccount><domain>NT AUTHORITY</domain><user>LocalService</user></serviceaccount>$\r$\n'
  ${EndIf}
  FileWriteUTF16LE $9 '$SvcExtra</service>$\r$\n'
  FileClose $9

  ; "refresh" updates an existing registration; "install" creates it.
  ClearErrors
  ReadRegStr $0 HKLM "SYSTEM\CurrentControlSet\Services\$SvcId" "ImagePath"
  ${If} ${Errors}
    !insertmacro RunChecked '"$6" install' "Could not register the $SvcName service."
  ${Else}
    !insertmacro RunChecked '"$6" refresh' "Could not update the $SvcName service."
    StrCpy $0 $SvcId 12
    ${If} $0 == "VaultcastPHP"
      !insertmacro RunChecked '"$SYSDIR\sc.exe" config $SvcId obj= LocalSystem' "Could not set the PHP service account."
    ${EndIf}
  ${EndIf}
  !insertmacro RunChecked '"$SYSDIR\net.exe" start $SvcId' "The $SvcName service did not start. Details are in $Runtime\logs."
FunctionEnd

; Build an <env> element in $SvcExtra. Usage: !insertmacro SvcEnv NAME VALUE
!macro SvcEnv NAME VALUE
  StrCpy $8 "${VALUE}"
  !insertmacro XmlEscape $8
  StrCpy $SvcExtra '$SvcExtra  <env name="${NAME}" value="$8"/>$\r$\n'
!macroend

; ---- Database ----
Function PrepareDatabase
  StrCpy $DbDepend ""
  ; Already configured: keep it, just make sure our database service runs.
  ${If} ${FileExists} "$INSTDIR\data\config.php"
    StrCpy $R9 "VaultcastDatabase"
    StrCpy $R8 $INSTDIR
    Call ServiceOwnership
    ${If} $R7 == "ours"
      nsExec::ExecToLog '"$SYSDIR\net.exe" start VaultcastDatabase'
      Pop $0
      StrCpy $DbDepend '  <depend>VaultcastDatabase</depend>$\r$\n'
      ${If} ${FileExists} "$Runtime\database.ini"
        !insertmacro RunChecked '"$Php" -c "$Runtime\php.ini" "$PLUGINSDIR\setup-helper.php" provision "$INSTDIR" "$Runtime\database.ini"' \
          "The managed database permissions could not be repaired."
      ${EndIf}
    ${EndIf}
    Return
  ${EndIf}

  ; External database: the browser setup collects the connection.
  ${If} $External == 1
    Delete "$INSTDIR\data\setup-database.php"
    StrCpy $R9 "VaultcastDatabase"
    StrCpy $R8 $INSTDIR
    Call ServiceOwnership
    ${If} $R7 == "ours"
      nsExec::ExecToLog '"$SYSDIR\sc.exe" config VaultcastDatabase start= demand'
      Pop $0
    ${EndIf}
    Return
  ${EndIf}

  ; Managed local MariaDB. Credentials live in an INI only SYSTEM/Administrators can read.
  StrCpy $R6 "$Runtime\database.ini"
  ${IfNot} ${FileExists} $R6
    ${If} ${FileExists} "$Runtime\database-secret.txt"
    ${AndIf} ${FileExists} "$INSTDIR\data\database\mysql\*.*"
      ; Written by the old PowerShell setup with DPAPI; it cannot be read natively.
      !insertmacro Fail "A partly completed earlier setup left an encrypted database secret. Finish it once with Installers\Windows\x86-64\install.cmd, then rerun this installer."
    ${EndIf}
    StrCpy $R0 3306
    StrCpy $R1 0
    StrCpy $R2 "127.0.0.1"
    Call ChoosePort
    WriteINIStr $R6 "database" "port" $R0
    WriteINIStr $R6 "database" "name" "vaultcast"
    !insertmacro PhpHelper 'secret'
    ${If} $0 != 0
      !insertmacro Fail "Could not generate database credentials."
    ${EndIf}
    WriteINIStr $R6 "database" "rootPassword" $1
    !insertmacro PhpHelper 'secret'
    StrCpy $2 $1 12
    WriteINIStr $R6 "database" "user" "rk_$2"
    !insertmacro PhpHelper 'secret'
    WriteINIStr $R6 "database" "password" $1
    FlushINI $R6
    nsExec::Exec '"$SYSDIR\icacls.exe" "$R6" /inheritance:r /grant:r ${SID_SYSTEM}:F ${SID_ADMINS}:F /Q'
    Pop $0
  ${Else}
    ReadINIStr $R0 $R6 "database" "port"
    StrCpy $ReservedPorts "$ReservedPorts$R0|"
  ${EndIf}
  ReadINIStr $DbPort $R6 "database" "port"
  ReadINIStr $R5 $R6 "database" "rootPassword"

  StrCpy $R4 "$Runtime\${RT_MARIADB}\bin"
  StrCpy $R3 "$INSTDIR\data\database"
  ${IfNot} ${FileExists} "$R3\mysql\*.*"
    DetailPrint "Creating MariaDB system tables. This can take a few minutes..."
    StrCpy $0 "$R4\mariadb-install-db.exe"
    ${IfNot} ${FileExists} $0
      StrCpy $0 "$R4\mysql_install_db.exe"
    ${EndIf}
    ; Output is not logged because the command line carries the root password.
    SetOutPath $R4
    nsExec::Exec '"$0" "--datadir=$R3" --password=$R5 --port=$DbPort'
    Pop $1
    FileOpen $9 "$Runtime\logs\mariadb-install.log" w
    FileWrite $9 "MariaDB initialization exit code: $1$\r$\n"
    FileClose $9
    ${If} $1 != 0
      !insertmacro Fail "MariaDB initialization failed (exit code $1). The database folder was left intact; rerun setup to retry."
    ${EndIf}
  ${EndIf}
  ; MariaDB replaces the folder ACL while creating its tables.
  !insertmacro GrantServiceWrite $R3

  ClearErrors
  ${ConfigRead} "$R3\my.ini" "bind-address" $0
  ${If} ${Errors}
    FileOpen $9 "$R3\my.ini" a
    FileSeek $9 0 END
    FileWrite $9 "$\r$\n[mysqld]$\r$\nbind-address=127.0.0.1$\r$\n"
    FileClose $9
  ${EndIf}

  StrCpy $SvcId "VaultcastDatabase"
  StrCpy $SvcName "Vaultcast Database"
  StrCpy $SvcExe "$R4\mariadbd.exe"
  StrCpy $SvcArgs '--defaults-file="$R3\my.ini" --console'
  StrCpy $SvcDir $R4
  StrCpy $SvcExtra ""
  StrCpy $SvcStopArgs ""
  Call InstallAppService
  StrCpy $DbDepend '  <depend>VaultcastDatabase</depend>$\r$\n'

  DetailPrint "Creating the private library database and account..."
  !insertmacro RunChecked '"$Php" -c "$Runtime\php.ini" "$PLUGINSDIR\setup-helper.php" provision "$INSTDIR" "$R6"' \
    "The database could not be prepared. Rerun setup to resume; saved credentials are reused."
FunctionEnd

; ---- Remove php-cgi services above $PhpWorkers left by an earlier, larger pool ----
Function RemoveSurplusPhpWorkers
  StrCpy $R8 $INSTDIR
  IntOp $R5 $PhpWorkers + 1
  ${If} $R5 < 2
    StrCpy $R5 2
  ${EndIf}
  ${ForEach} $R6 $R5 ${PHP_WORKERS_MAX} + 1
    StrCpy $R9 "VaultcastPHP$R6"
    Call ServiceOwnership
    ${If} $R7 == "ours"
      DetailPrint "Removing surplus service $R9..."
      nsExec::ExecToLog '"$SYSDIR\net.exe" stop $R9'
      Pop $0
      nsExec::ExecToLog '"$Runtime\services\$R9.exe" uninstall'
      Pop $0
      ${If} $0 != 0
        nsExec::ExecToLog '"$SYSDIR\sc.exe" delete $R9'
        Pop $0
      ${EndIf}
      Delete "$Runtime\services\$R9.exe"
      Delete "$Runtime\services\$R9.xml"
    ${EndIf}
  ${Next}
FunctionEnd

; ---- nginx (ported from Application/deploy/nginx.conf.example for Windows) ----
Function WriteNginxConf
  StrCpy $1 $INSTDIR
  StrCpy $2 "$INSTDIR\data\tmp"
  !insertmacro ForwardSlashes $1
  !insertmacro ForwardSlashes $2
  FileOpen $9 "$Runtime\${RT_NGINX}\conf\vaultcast.conf" w
  FileWrite $9 "# Generated by the Vaultcast installer. Rerun setup to regenerate.$\r$\n"
  FileWrite $9 "daemon off;$\r$\nevents { worker_connections 512; }$\r$\n"
  FileWrite $9 "http {$\r$\ninclude mime.types;$\r$\ndefault_type application/octet-stream;$\r$\n"
  FileWrite $9 'client_body_temp_path "$2/client_body";$\r$\nproxy_temp_path "$2/proxy";$\r$\n'
  FileWrite $9 'fastcgi_temp_path "$2/fastcgi";$\r$\nuwsgi_temp_path "$2/uwsgi";$\r$\nscgi_temp_path "$2/scgi";$\r$\n'
  FileWrite $9 "map $$http_upgrade $$vaultcast_connection {$\r$\n    default upgrade;$\r$\n    '' close;$\r$\n}$\r$\n"
  FileWrite $9 "sendfile on;$\r$\n"
  ; php-cgi pool (one process per port). Requests go to the least busy worker.
  FileWrite $9 "upstream vaultcast_php {$\r$\n    least_conn;$\r$\n"
  ${ForEach} $R5 1 $PhpWorkers + 1
    ${WordFind} "$PhpPorts" " " "+$R5" $R4
    FileWrite $9 "    server 127.0.0.1:$R4;$\r$\n"
  ${Next}
  FileWrite $9 "}$\r$\n"
  FileWrite $9 "server {$\r$\n    listen $ListenAddress:$WebPort;$\r$\n    server_name _;$\r$\n"
  FileWrite $9 '    root "$1";$\r$\n'
  FileWrite $9 "    index index.php;$\r$\n    client_max_body_size 16m;$\r$\n    autoindex off;$\r$\n$\r$\n"
  ; Media via X-Accel-Redirect: PHP checks the playback token and the library folder,
  ; then hands /_vaultcast_media/<C:/path> to nginx, which serves it (with byte ranges)
  ; so no php-cgi worker is held for the length of a stream. First regex, so the deny
  ; rules below cannot reject a library path (e.g. a dot-folder). Drive-letter paths need
  ; the regex (alias / would resolve to the nginx drive, e.g. Z:/C:/...). Internal only.
  FileWrite $9 '    location ~ "^/_vaultcast_media/([A-Za-z]):/(.*)$$" {$\r$\n'
  FileWrite $9 "        internal;$\r$\n        alias $$1:/$$2;$\r$\n        sendfile on;$\r$\n"
  FileWrite $9 "    }$\r$\n"
  FileWrite $9 "    location ~ /\. { deny all; }$\r$\n"
  FileWrite $9 "    location ~* ^/(src|data|deploy|docs|netplay)(/|$$) { deny all; }$\r$\n"
  FileWrite $9 "    location ~* \.(sql|md|log|sh|ps1|cmd|yaml|yml|lock|bak|exe)$$ { deny all; }$\r$\n$\r$\n"
  FileWrite $9 "    location = /index.html { return 302 /; }$\r$\n"
  FileWrite $9 "    location / { try_files $$uri $$uri/ /index.php; }$\r$\n"
  FileWrite $9 "    location = /index.php {$\r$\n        include fastcgi_params;$\r$\n"
  FileWrite $9 "        fastcgi_param SCRIPT_FILENAME $$document_root/index.php;$\r$\n"
  FileWrite $9 "        fastcgi_pass vaultcast_php;$\r$\n    }$\r$\n"
  FileWrite $9 "    location = /api { return 302 /api/status; }$\r$\n"
  FileWrite $9 "    location ^~ /api/ {$\r$\n        include fastcgi_params;$\r$\n"
  FileWrite $9 "        fastcgi_param SCRIPT_FILENAME $$document_root/index.php;$\r$\n"
  FileWrite $9 "        fastcgi_param SCRIPT_NAME /index.php;$\r$\n        fastcgi_read_timeout 300s;$\r$\n"
  FileWrite $9 "        fastcgi_pass vaultcast_php;$\r$\n    }$\r$\n"
  FileWrite $9 "    location ~* \.php(?:/|$$) { deny all; }$\r$\n"
  FileWrite $9 "    location ^~ /netplay/ {$\r$\n        proxy_pass http://127.0.0.1:$RelayPort/;$\r$\n"
  FileWrite $9 "        proxy_http_version 1.1;$\r$\n        proxy_set_header Upgrade $$http_upgrade;$\r$\n"
  FileWrite $9 "        proxy_set_header Connection $$vaultcast_connection;$\r$\n        proxy_set_header Host $$host;$\r$\n"
  FileWrite $9 "        proxy_read_timeout 120s;$\r$\n    }$\r$\n"
  FileWrite $9 '    location = /sw.js { add_header Cache-Control "no-cache"; }$\r$\n}$\r$\n}$\r$\n'
  FileClose $9
FunctionEnd

; ---- setup.json (read by the script installer on later repairs) ----
Function WriteSetupJson
  StrCpy $1 $INSTDIR
  ${WordReplace} $1 "\" "\\" "+" $1
  FileOpen $9 "$Runtime\setup.json" w
  FileWrite $9 '{$\r$\n  "webPort": $WebPort,$\r$\n  "phpPort": $PhpPort,$\r$\n  "phpWorkers": $PhpWorkers,$\r$\n  "mediaAccel": true,$\r$\n  "netplayPort": $RelayPort,$\r$\n'
  FileWrite $9 '  "listenAddress": "$ListenAddress",$\r$\n  "installRoot": "$1"$\r$\n}$\r$\n'
  FileClose $9
FunctionEnd

; ---- Firewall (netsh replaces New-/Remove-NetFirewallRule) ----
Function ConfigureFirewall
  nsExec::ExecToLog '"$SYSDIR\netsh.exe" advfirewall firewall delete rule name="${FIREWALL_RULE}"'
  Pop $0
  ${If} $ListenAddress != "127.0.0.1"
    !insertmacro RunChecked '"$SYSDIR\netsh.exe" advfirewall firewall add rule name="${FIREWALL_RULE}" dir=in action=allow protocol=TCP localport=$WebPort program="$Runtime\${RT_NGINX}\nginx.exe" profile=private,domain remoteip=localsubnet' \
      "Could not add the Windows Firewall rule for the library."
  ${EndIf}
FunctionEnd

; ---- Wait until every service accepts connections ----
Function WaitForServices
  DetailPrint "Waiting for Vaultcast to start..."
  ; Host goes in $4: PhpHelper pops its output into $0/$1.
  StrCpy $4 "127.0.0.1"
  ${If} $ListenAddress != "0.0.0.0"
    StrCpy $4 $ListenAddress
  ${EndIf}
  ; Every php-cgi worker of the pool, then the relay and the web server.
  ${ForEach} $R5 2 $PhpWorkers + 1
    ${WordFind} "$PhpPorts" " " "+$R5" $R4
    StrCpy $3 "127.0.0.1:$R4"
    !insertmacro PhpHelper 'wait 127.0.0.1 $R4'
    ${If} $0 != 0
      !insertmacro Fail "A Vaultcast service did not start on $3. Details are in $Runtime\logs. Rerun setup to resume."
    ${EndIf}
  ${Next}
  ${ForEach} $2 0 2 + 1
    ${If} $2 == 0
      StrCpy $3 "127.0.0.1:$PhpPort"
      !insertmacro PhpHelper 'wait 127.0.0.1 $PhpPort'
    ${ElseIf} $2 == 1
      StrCpy $3 "127.0.0.1:$RelayPort"
      !insertmacro PhpHelper 'wait 127.0.0.1 $RelayPort'
    ${Else}
      StrCpy $3 "$4:$WebPort"
      !insertmacro PhpHelper 'wait $4 $WebPort'
    ${EndIf}
    ${If} $0 != 0
      !insertmacro Fail "A Vaultcast service did not start on $3. Details are in $Runtime\logs. Rerun setup to resume."
    ${EndIf}
  ${Next}
FunctionEnd

; ---- Reset administrator password ----
Function ResetAdministrator
  StrCpy $Runtime "$INSTDIR\data\runtime"
  StrCpy $Php "$Runtime\${RT_PHP}\php.exe"
  ${IfNot} ${FileExists} $Php
    !insertmacro Fail "The installed PHP runtime was not found. Run Update or repair first."
  ${EndIf}
  ; Credentials go through a temporary file (deleted by the helper), never the command line.
  StrCpy $1 "$PLUGINSDIR\reset.txt"
  FileOpen $9 $1 w
  FileWriteUTF16LE /BOM $9 "$ResetUser$\n$ResetPassword"
  FileClose $9
  StrCpy $ResetPassword ""
  nsExec::ExecToLog '"$Php" -c "$Runtime\php.ini" "$PLUGINSDIR\setup-helper.php" reset-admin "$INSTDIR" "$Runtime\php.ini" "$1"'
  Pop $0
  Delete $1
  ${If} $0 != 0
    !insertmacro Fail "The administrator password could not be reset. Check the username and try again."
  ${EndIf}
  DetailPrint "Password reset. Earlier sessions for this account were signed out."
  MessageBox MB_ICONINFORMATION "Password reset. Earlier sessions for this account were signed out." /SD IDOK
FunctionEnd

; ---- Transmission download service ----
; Vaultcast runs its own transmission-daemon (WinSW service, LocalService) with a
; private config folder, so a desktop Transmission and its settings are untouched.
; RPC: 127.0.0.1 only, random credentials, whitelist 127.0.0.1. Credentials live in
; data\runtime\transmission.ini (SYSTEM/Administrators only) and are kept on upgrade;
; Vaultcast's PHP service reads them to fill Settings > Downloads automatically.
Function ConfigureTransmission
  StrCpy $R6 "$Runtime\transmission.ini"
  StrCpy $R3 "$INSTDIR\data\transmission"
  ${IfNot} ${FileExists} $R6
    DetailPrint "Creating Transmission download service settings..."
    StrCpy $R0 9091
    StrCpy $R1 0
    StrCpy $R2 "127.0.0.1"
    Call ChoosePort
    WriteINIStr $R6 "transmission" "port" $R0
    StrCpy $R0 51413
    StrCpy $R2 "0.0.0.0"
    Call ChoosePort
    WriteINIStr $R6 "transmission" "peer_port" $R0
    !insertmacro PhpHelper 'secret'
    ${If} $0 != 0
      !insertmacro Fail "Could not generate Transmission credentials."
    ${EndIf}
    StrCpy $2 $1 12
    WriteINIStr $R6 "transmission" "username" "rk_$2"
    !insertmacro PhpHelper 'secret'
    WriteINIStr $R6 "transmission" "password" $1
    ; Downloads live outside the install folder so Vaultcast may tidy finished torrents
    ; (it never deletes inside its own folder) and nginx never serves them.
    ExpandEnvStrings $0 "%PUBLIC%"
    ${If} $0 == "%PUBLIC%"
    ${OrIf} $0 == ""
      StrCpy $0 "$APPDATA"
    ${EndIf}
    WriteINIStr $R6 "transmission" "download_dir" "$0\Downloads\${PRODUCT_NAME}"
    FlushINI $R6
    nsExec::Exec '"$SYSDIR\icacls.exe" "$R6" /inheritance:r /grant:r ${SID_SYSTEM}:F ${SID_ADMINS}:F /Q'
    Pop $0
  ${EndIf}
  ReadINIStr $TrPort $R6 "transmission" "port"
  ReadINIStr $TrPeerPort $R6 "transmission" "peer_port"
  ReadINIStr $TrUser $R6 "transmission" "username"
  ReadINIStr $TrPassword $R6 "transmission" "password"
  ReadINIStr $TrDownloads $R6 "transmission" "download_dir"

  CreateDirectory "$TrDownloads\.incomplete"
  !insertmacro GrantServiceWrite $TrDownloads
  CreateDirectory $R3

  ; settings.json is written only once: afterwards the daemon owns it (it hashes the
  ; password and stores changes Vaultcast makes over RPC, e.g. seeding limits).
  ${IfNot} ${FileExists} "$R3\settings.json"
    StrCpy $1 $TrDownloads
    ${WordReplace} $1 "\" "\\" "+" $1
    FileOpen $9 "$R3\settings.json" w
    FileWrite $9 '{$\r$\n'
    FileWrite $9 '  "download-dir": "$1",$\r$\n'
    FileWrite $9 '  "incomplete-dir": "$1\\.incomplete",$\r$\n  "incomplete-dir-enabled": true,$\r$\n'
    FileWrite $9 '  "peer-port": $TrPeerPort,$\r$\n  "peer-port-random-on-start": false,$\r$\n'
    FileWrite $9 '  "rpc-enabled": true,$\r$\n  "rpc-bind-address": "127.0.0.1",$\r$\n  "rpc-port": $TrPort,$\r$\n'
    FileWrite $9 '  "rpc-authentication-required": true,$\r$\n'
    FileWrite $9 '  "rpc-username": "$TrUser",$\r$\n  "rpc-password": "$TrPassword",$\r$\n'
    FileWrite $9 '  "rpc-whitelist-enabled": true,$\r$\n  "rpc-whitelist": "127.0.0.1",$\r$\n'
    FileWrite $9 '  "rpc-host-whitelist-enabled": true,$\r$\n  "rpc-host-whitelist": "localhost,127.0.0.1",$\r$\n'
    FileWrite $9 '  "ratio-limit": 0,$\r$\n  "ratio-limit-enabled": true,$\r$\n'
    FileWrite $9 '  "start-added-torrents": true,$\r$\n  "umask": "022"$\r$\n}$\r$\n'
    FileClose $9
  ${EndIf}

  ; Peer traffic: allow the daemon program up front so Windows never asks.
  StrCpy $2 "$Runtime\${RT_TRANSMISSION}\transmission-daemon.exe"
  nsExec::ExecToLog '"$SYSDIR\netsh.exe" advfirewall firewall delete rule name="${FIREWALL_RULE_DOWNLOADS}"'
  Pop $0
  !insertmacro RunChecked '"$SYSDIR\netsh.exe" advfirewall firewall add rule name="${FIREWALL_RULE_DOWNLOADS}" dir=in action=allow program="$2" profile=any' \
    "Could not add the Windows Firewall rule for downloads."

  StrCpy $SvcId "VaultcastTransmission"
  StrCpy $SvcName "Vaultcast Downloads (Transmission)"
  StrCpy $SvcExe $2
  StrCpy $SvcArgs '-f -g "$R3"'
  StrCpy $SvcDir "$Runtime\${RT_TRANSMISSION}"
  StrCpy $SvcStopArgs ""
  StrCpy $SvcExtra ""
  !insertmacro SvcEnv "TRANSMISSION_WEB_HOME" "$Runtime\${RT_TRANSMISSION}\public_html"
  Call InstallAppService

  !insertmacro PhpHelper 'wait 127.0.0.1 $TrPort'
  ${If} $0 == 0
    DetailPrint "Downloads are ready."
  ${Else}
    DetailPrint "The Transmission service has not answered yet; Vaultcast keeps trying in the background."
  ${EndIf}
FunctionEnd
