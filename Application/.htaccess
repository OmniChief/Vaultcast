# Apache (optional; nginx is the supported server, see deploy/nginx.conf.example).
# Needs mod_rewrite and AllowOverride FileInfo. Clean URLs (/movies/<slug>) and /api/* go to index.php.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|data|deploy|docs|netplay|tests)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(sql|md|log|sh|ps1|cmd|ya?ml|lock|bak)$ - [F,L]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule !\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
